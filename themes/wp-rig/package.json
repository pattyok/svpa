	"license": "GPL-3.0-or-later",
	"main": "index.php",
	"homepage": "https://github.com/wprig/wprig#readme",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/wprig/wprig.git"
	},
	"engines": {
		"node": ">=20.13.1",
		"npm": ">=10.5.2"
	},
	"bugs": {
		"url": "https://github.com/wprig/wprig/issues"
	},
	"devDependencies": {
		"@babel/core": "^7.21.4",
		"@babel/preset-env": "^7.25.4",
		"@babel/preset-react": "^7.24.7",
		"@babel/register": "^7.4.4",
		"@justinribeiro/lite-youtube": "^1.5.0",
		"@wordpress/eslint-plugin": "^26.0.0",
		"@wordpress/stylelint-config": "^22.6.0",
		"ajv": "^6.12.3",
		"ansi-colors": "^4.1.1",
		"autoprefixer": "^10.5.4",
		"babel-jest": "^29.7.0",
		"browser-sync": "^3.0.4",
		"create-cert": "^1.0.6",
		"cross-env": "^5.2.0",
		"cssnano": "^7.1.9",
		"deepmerge": "^4.0.0",
		"del": "^5.0.0",
		"eslint": "^9.39.5",
		"eslint-config-gulp": "^3.0.1",
		"eslint-config-standard": "^13.0.1",
		"eslint-plugin-import": "^2.18.0",
		"eslint-plugin-node": "^9.1.0",
		"eslint-plugin-promise": "^4.2.1",
		"eslint-plugin-standard": "^4.0.0",
		"esm": "^3.2.25",
		"esvalidate": "^0.1.3",
		"fancy-log": "^1.3.3",
		"glob": "^7.1.4",
		"gulp": "^5.0.1",
		"gulp-babel": "^8.0.0",
		"gulp-if": "^2.0.2",
		"gulp-imagemin": "^9.2.0",
		"gulp-load-plugins": "^2.0.0",
		"gulp-newer": "^1.4.0",
		"gulp-notify": "^3.2.0",
		"gulp-phpcs": "^3.1.0",
		"gulp-plumber": "^1.2.1",
		"gulp-postcss": "^10.0.0",
		"gulp-potomo": "^1.1.0",
		"gulp-print": "^5.0.2",
		"gulp-rename": "^1.4.0",
		"gulp-sort": "^2.0.0",
		"gulp-string-replace": "^1.1.2",
		"gulp-tabify": "0.0.2",
		"gulp-uglify": "^3.0.2",
		"gulp-wp-pot": "^2.3.5",
		"gulp-zip": "^5.0.0",
		"globals": "^16.5.0",
		"import-fresh": "^3.1.0",
		"jest": "^26.6.3",
		"jest-expect-message": "^1.0.2",
		"map-stream": "0.0.7",
		"mississippi": "^4.0.0",
		"mkdirp": "^0.5.1",
		"npm-run-all": "^4.1.5",
		"postcss": "^8.4.44",
		"postcss-calc": "^10.1.1",
		"postcss-import": "^14.0.0",
		"postcss-nested": "^6.2.0",
		"postcss-preset-env": "^10.0.2",
		"postcss-reporter": "^7.1.0",
		"postcss-simple-vars": "^7.0.1",
		"pump": "^3.0.0",
		"rimraf": "^2.6.3",
		"stylelint": "^14",
		"vinyl": "^2.2.0"
	},
	"babel": {
		"presets": [
			"@babel/preset-react",
			"@babel/preset-env"
		]
	},
	"eslintConfig": {
		"extends": "plugin:@wordpress/eslint-plugin/recommended",
		"root": true,
		"env": {
			"browser": true,
			"node": true,
			"es6": true
		},
		"globals": {
			"jQuery": "readonly",
			"wp": "readonly"
		}
	},
	"jest": {
		"setupFilesAfterEnv": [
			"jest-expect-message"
		]
	},
	"scripts": {
		"build": "gulp buildDev",
		"bundle": "cross-env NODE_ENV=production gulp bundleTheme",
		"dev": "gulp",
		"gulp": "gulp",
		"generateCert": "gulp generateCert",
		"rig-init": "npm install && composer install",
		"translate": "gulp translate",
		"test:gulp:dev": "jest gulp/tests --testPathIgnorePatterns gulp/tests/prod-build",
		"test:gulp:prod:setup": "NODE_ENV=production node -r esm gulp/tests/prod-build/prod-build.setup.js",
		"test:gulp:prod:teardown": "NODE_ENV=production node -r esm gulp/tests/prod-build/prod-build.teardown.js",
		"test:gulp:prod:run": "cross-env NODE_ENV=production jest gulp/tests/prod-build",
		"test:gulp:prod": "run-s test:gulp:prod:setup bundle test:gulp:prod:run test:gulp:prod:teardown",
		"test:gulp": "run-s test:gulp:dev test:gulp:prod",
		"lint": "eslint assets/js/src/",
		"lint:gulp": "eslint gulp/",
		"lint:gulp:fix": "eslint --fix gulp/",
		"editor-support": "node gulp/editorSupport.js"
	}
}
