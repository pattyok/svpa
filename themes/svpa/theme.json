{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"useRootPaddingAwareAlignments": true,
		"color": {
			"defaultDuotone": false,
			"defaultGradients": false,
			"customGradients": false,
			"defaultPalette": false,
			"palette": [
				{
				"slug": "primary",
				"color": "#011F3E",
				"name": "Dark Blue"
				},
				{
				"slug": "secondary",
				"color": "#064A27",
				"name": "Dark Green"
				},

				{
				"slug": "contrast",
				"color": "#000000",
				"name": "Black"
				},
				{
				"slug": "base",
				"color": "#ffffff",
				"name": "White"
				},
				{
				"slug": "header",
				"color": "#264354",
				"name": "Dark Blue (Headers)"
				},
				{
				"slug": "accent-1",
				"color": "#38802B",
				"name": "Green"
				},
				{
				"slug": "accent-2",
				"color": "#EBCF52",
				"name": "Yellow"
				},
				{
				"slug": "grey-light",
				"color": "#F5F5F7",
				"name": "Light Grey"
				},
				{
				"slug": "grey-med",
				"color": "#AAAAAA",
				"name": "Medium Grey"
				},
				{
				"slug": "white-transparent",
				"color": "rgba(255, 255, 255, 0.85)",
				"name": "White Transparent"
				}
			]
		},
		"layout": {
			"contentSize": "var(--content-width)",
			"wideSize": "var(--content-width-wide)"
		},
		"spacing": {
			"defaultSpacingSizes": false,
			"spacingSizes": [
				{
					"name": "Tiny",
					"size": "10px",
					"slug": "20"
				},
				{
					"name": "X-Small",
					"size": "1rem",
					"slug": "30"
				},
				{
					"name": "Small",
					"size": "clamp(10px, 1.6vw, 20px)",
					"slug": "40"
				},
				{
					"name": "Regular",
					"size": "clamp(15px, 3vw, 40px)",
					"slug": "50"
				},
				{
					"name": "Large",
					"size": "clamp(20px, 4vw, 50px)",
					"slug": "60"
				},
				{
					"name": "X-Large",
					"size": "clamp(24px, 5vw, 60px)",
					"slug": "70"
				},
				{
					"name": "XX-Large",
					"size": "clamp(24px, 6vw, 80px)",
					"slug": "80"
				}
			],
			"units": [
				"%",
				"px",
				"em",
				"rem",
				"vh",
				"vw"
			]
		},
		"typography": {
			"writingMode": true,
			"defaultFontSizes": false,
			"fluid": true,
			"fontSizes": [

				{
					"fluid": {
						"max": "0.9375rem",
						"min": "0.9375rem"
					},
					"name": "Extra Small",
					"size": "0.9375rem",
					"slug": "x-small"
				},
				{
					"fluid": {
						"max": "1rem",
						"min": "1rem"
					},
					"name": "Small",
					"size": "1rem",
					"slug": "small"
				},
				{
					"fluid": {
						"max": "1.125rem",
						"min": "1.125rem"
					},
					"name": "Base",
					"size": "1.125rem",
					"slug": "base"
				},
				{
					"fluid": {
						"max": "1.3125rem",
						"min": "1.125rem"
					},
					"name": "Large",
					"size": "1.3125rem",
					"slug": "large"
				},
				{
					"fluid": {
						"max": "1.5rem",
						"min": "1.375rem"
					},
					"name": "Extra Large",
					"size": "1.375rem",
					"slug": "x-large"
				},
				{
					"fluid": {
						"max": "3.75rem",
						"min": "3.1875rem"
					},
					"name": "Extra Extra Large",
					"size": "3.75rem",
					"slug": "xx-large"
				}
			],
			"fontFamilies": [
				{
					"name": "Montserrat",
					"slug": "headings",
					"fontFamily": "Montserrat, sans-serif"
				},
				{
					"name": "Museo Sans",
					"slug": "global",
					"fontFamily": "museo-sans, sans-serif"
				}
			]
		},
		"blocks":{
			"core/heading": {
				"typography": {
					"fontSizes": [
						{
						"slug": "h1",
						"size": "var(--font-size-h1)",
						"name": "H1"
						},
						{
						"slug": "h2",
						"size": "var(--font-size-h2)",
						"name": "H2"
						},
						{
						"slug": "h3",
						"size": "var(--font-size-h3)",
						"name": "H3"
						},
						{
						"slug": "h4",
						"size": "var(--font-size-h4)",
						"name": "H4"
						},
						{
						"slug": "h5",
						"size": "var(--font-size-h5)",
						"name": "H5"
						},
						{
						"slug": "h6",
						"size": "var(--font-size-h6)",
						"name": "H6"
						}
					]
        		}
      		}
		}
	},
	"styles": {
		"color": {
			"background": "var:preset|color|base",
			"text": "var:preset|color|contrast"
		},
		"spacing": {
			"blockGap": "var:preset|spacing|40"
		},
		"typography": {
			"fontFamily": "var:preset|font-family|global",
			"fontSize": "var:preset|font-size|base",
			"fontWeight": "500",
			"letterSpacing": "0",
			"lineHeight": "1.64"
		},
		"blocks": {
			"core/avatar": {
				"border": {
					"radius": "100px"
				}
			},
			"core/group": {
				"spacing": {
					"blockGap": "var:preset|spacing|50"
				}
			},
			"core/columns": {
				"spacing": {
					"blockGap": "var:preset|spacing|60"
				}
			},
			"core/column": {
				"spacing": {
					"blockGap": "var:preset|spacing|50"
				}
			},
			"core/paragraph": {
				"spacing": {
					"margin": {
						"top": "var:preset|spacing|30"
					}
				}
			},
			"core/list": {
				"spacing": {
					"margin": {
						"top": "var:preset|spacing|30"
					}
				}
			},
			"core/buttons": {
				"spacing": {
					"blockGap": "var:preset|spacing|20"
				}
			},
			"core/cover": {
				"dimRatio": "0",
				"dimensions": {
				"aspectRatio": "4/3"
				}
			},
			"core/social-links": {
				"openInNewTab": true,
				"spacing": {
					"blockGap": {
						"left": "var:preset|spacing|20"
					}
				}
			},

			"core/post-navigation-link": {
				"typography": {
					"fontSize": "var:preset|font-size|base"
				}
			},
			"core/post-terms": {
				"css": "& a { white-space: nowrap; }",
				"typography": {
					"fontSize": "var:preset|font-size|small",
					"fontWeight": "600"
				}
			},
			"core/pullquote": {
				"typography": {
					"fontSize": "var:preset|font-size|x-large",
					"lineHeight": "1.6",
					"textAlign": "left"
				},
				"elements": {
					"cite": {
						"typography": {
							"fontSize": "var:preset|font-size|small",
							"fontStyle": "normal",
							"textTransform": "none"
						}
					}
				},
				"spacing": {
					"padding": {
						"bottom": "var:preset|spacing|30",
						"top": "var:preset|spacing|30"
					}
				},
				"css": "& p:last-of-type {margin-bottom: var(--wp--preset--spacing--30);}"
			},
			"core/query-pagination": {
				"typography": {
					"fontSize": "var:preset|font-size|base",
					"fontWeight": "500"
				}
			},

			"core/separator": {
				"border": {
					"color": "currentColor",
					"style": "solid",
					"width": "0 0 2px 0"
				},
				"spacing": {
					"margin": {
						"top": "var:preset|spacing|70",
						"bottom": "var:preset|spacing|70"
					}
				},
				"variations": {
					"wide": {
						"css": " &:not(.alignfull){max-width: var(--wp--style--global--wide-size) !important;}"
					}
				}
			},

			"core/navigation": {
				"typography": {
					"fontSize": "var:preset|font-size|base"
				},
				"elements": {
					"link": {
						":hover": {
							"typography": {
								"textDecoration": "underline"
							}
						},
						"typography": {
							"textDecoration": "none"
						}
					}
				}
			}
		},
		"elements": {
			"button": {
				"color": {
					"background": "var:preset|color|accent-1",
					"text": "var:preset|color|background"
				},
				"border": {
					"radius": "0",
					"color": "currentColor",
					"width": "0",
					"style": "solid"
				},

				"spacing": {
					"padding": {
						"bottom": "1.0625rem",
						"left": "1.875rem",
						"right": "1.875rem",
						"top": "1.0625rem"
					}
				},
				"typography": {
					"fontFamily": "var:preset|font-family|headings",
					"textTransform": "uppercase",
					"fontSize": "var:preset|font-size|small",
					"fontWeight": "900",
					"letterSpacing": "0.32px"
				},
				":hover":{
					"color": {
						"text": "var:preset|color|background",
						"background": "var:preset|color|accent-2"
					},
					"border": {
						"color": "var:preset|color|accent-2"
					},
					"typography": {
						"textDecoration": "none"
					}
				}
			},
			"caption": {
				"typography": {
					"fontSize": "var:preset|font-size|small",
					"lineHeight": "1.4"
				}
			},

			"link": {
				"color": {
					"text": "var:preset|color|accent-1"
				},
				"typography": {
					"textDecoration": "none",
					"fontWeight": "700"
				},
				":hover": {
					"typography": {
						"textDecoration": "underline"
					}
				}
			}
		}
	},
	"templateParts": [
		{
			"area": "header",
			"name": "site-header-top",
			"title": "Header Top"
		},
		{
			"area": "header",
			"name": "site-navigation-right",
			"title": "Site Navigation Right"
		},
		{
			"area": "header",
			"name": "site-navigation-left",
			"title": "Site Navigation Left"
		},
		{
			"area": "footer",
			"name": "site-footer",
			"title": "Site Footer"
		},
		{
			"area": "footer",
			"name": "post-footer",
			"title": "Post Footer"
		},
		{
			"area": "layouts",
			"name": "people",
			"title": "People"
		}

	],
	"customTemplates": [
		{
			"name": "page-no-title",
			"postTypes": ["page"],
			"title": "Page No Title"
		}
	]
}
